{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sound-detective",
  "pages_build_output_dir": "./dist-cloudflare",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "ADMIN_HUB_DATA",
      "id": "a6b3a926a6624e4892e0e43741e19619"
    },
    {
      "binding": "SOUND_DETECTIVE_DATA",
      "id": "d3d0526f213e4ec29e6223751b609a7c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ADMIN_HUB_ASSETS",
      "bucket_name": "game-admin-assets"
    }
  ],
  "vars": {
    "DX100_STORAGE": "cloudflare",
    "PUBLIC_MODE": "true",
    "TENCENT_ASR_ENGINE_MODEL_TYPE": "16k_zh_en",
    "TENCENT_ASR_ENABLED": "true"
  }
}
