# Netlify local release credentials. Do not commit real values.
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_AUTH_TOKEN=your-netlify-personal-access-token

# Hidden admin entry. ADMIN_SECRET_PATH is the only URL you should bookmark.
ADMIN_SECRET_PATH=/manage-your-random-secret
ADMIN_TOKEN=replace-with-a-long-random-token

# Cloud storage.
DX100_STORAGE=netlify-blobs
DX100_BLOBS_STORE=dx100-sound-game

# Online speech-to-text.
STT_PROVIDER=baidu
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
BAIDU_ASR_ENDPOINT=https://vop.baidu.com/pro_api
BAIDU_ASR_DEV_PID=80001
BAIDU_ASR_FORMAT=pcm
BAIDU_ASR_RATE=16000
BAIDU_ASR_CUID=voice-detective-cloud
