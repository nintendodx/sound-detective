# Cloudflare local release credentials. Optional if you use `npx wrangler login`.
# A token needs Workers Scripts, Workers KV Storage, Account Settings read, and User read scopes.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_PAGES_PROJECT=sound-detective

# Cloud storage.
DX100_STORAGE=cloudflare

# Online speech-to-text.
STT_PROVIDER=baidu
BAIDU_APP_ID=your-baidu-app-id
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
BAIDU_REALTIME_ASR_ENABLED=true
BAIDU_ASR_ENDPOINT=https://vop.baidu.com/pro_api
BAIDU_ASR_DEV_PID=80001
BAIDU_ASR_FORMAT=pcm
BAIDU_ASR_RATE=16000
BAIDU_ASR_CUID=voice-detective-cloud
BAIDU_REALTIME_ASR_DEV_PID=15372

# Realtime ASR random split. Fill these to enable Tencent and Doubao online.
TENCENT_ASR_APP_ID=your-tencent-asr-app-id
TENCENT_ASR_SECRET_ID=your-tencent-asr-secret-id
TENCENT_ASR_SECRET_KEY=your-tencent-asr-secret-key
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_en_speaker
TENCENT_ASR_VAD_SILENCE_TIME=800
TENCENT_ASR_ENABLED=true

DOUBAO_ASR_API_KEY=your-doubao-asr-api-key
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_ASR_END_WINDOW_SIZE=800
DOUBAO_ASR_FORCE_TO_SPEECH_TIME=1000
DOUBAO_ASR_ENABLED=true
