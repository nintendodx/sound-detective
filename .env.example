# Never commit real credentials. The server signs a short-lived Tencent URL;
# the browser sends audio directly to Tencent and never receives these secrets.
TENCENT_ASR_ENABLED=true
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENDPOINT=wss://asr.cloud.tencent.com/asr/v2
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_en
TENCENT_ASR_VAD_SILENCE_TIME=800
TENCENT_ASR_NOISE_THRESHOLD=
TENCENT_ASR_HOTWORD_ID=
TENCENT_ASR_HOTWORD_LIMIT=128
TENCENT_ASR_HOTWORD_WEIGHT=6

# Optional separate key for the internal ASR session ticket.
ASR_SESSION_SECRET=
