# 推荐给本地 demo：本地 whisper.cpp，不走任何公网 API。
STT_PROVIDER=local
LOCAL_WHISPER_BIN=tools/whisper-local/ggml-org-whisper.cpp-0b9af32/main
LOCAL_WHISPER_MODEL=tools/whisper-local/models/ggml-base-q5_1.bin
LOCAL_WHISPER_LANGUAGE=zh
LOCAL_WHISPER_THREADS=4

# 备用：Groq Whisper，不走 OpenAI API，但需要 Groq Key。
# STT_PROVIDER=groq
# GROQ_API_KEY=gsk-your-groq-api-key-here
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=zh

# 备用：OpenAI 转文字。
# STT_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 备用：百度智能云短语音识别极速版。
# STT_PROVIDER=baidu
# BAIDU_APP_ID=your-baidu-app-id
# BAIDU_API_KEY=your-baidu-api-key
# BAIDU_SECRET_KEY=your-baidu-secret-key
# BAIDU_REALTIME_ASR_ENABLED=false
# BAIDU_ASR_ENDPOINT=https://vop.baidu.com/pro_api
# BAIDU_ASR_DEV_PID=80001
# BAIDU_ASR_FORMAT=pcm
# BAIDU_ASR_RATE=16000
# BAIDU_ASR_CUID=voice-detective-demo
BAIDU_REALTIME_ASR_DEV_PID=15372

# MiniMax ASR 对比工具，不影响游戏默认链路。
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_ASR_ENDPOINT=https://your-minimax-asr-endpoint
# MINIMAX_ASR_MODEL=your-minimax-asr-model
# MINIMAX_ASR_MODE=multipart
# MINIMAX_ASR_LANGUAGE=zh
